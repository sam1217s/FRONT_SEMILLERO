				{
					"name": "Login SUPER",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const jsonData = pm.response.json();",
									"    pm.environment.set('tokensuper', jsonData.token);",
									"    pm.environment.set('token', jsonData.token);",
									"    pm.environment.set('current_role', 'SUPER');",
									"    console.log('✅ Token SUPER guardado → tokensuper');",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"document_number\": \"99999999\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/researchers/login",
							"host": ["{{base_url}}"],
							"path": ["api", "researchers", "login"]
						}
					}
